# Generated by tools/build-set for each built set and pinned by
# ai-tools-base; never committed, so the file always matches the tree
# it was built from.
sets/*/SHA256SUMS
sets/*/SHA256SUMS.asc
sets/*/SHA512SUMS*

# Built sets and nFPM packages. CI refuses a committed binary, and a
# package is rebuilt from the tag.
build/
dist/
*.rpm
*.deb
*.apk
*.pkg.tar.zst

# .NET build output. A skill ships C# as source; `dotnet run` builds it
# into the user's home, never beside the source.
bin/
obj/
artifacts/

# Python bytecode cache, created when a skill script or a tool runs.
__pycache__/
*.pyc
.ruff_cache/

# Editor and IDE state.
.idea/
.vscode/
*~
.#*

# Credential-pattern files stay out of a public repository.
.env
.env/
*.pem
*.key

# Per-user Claude Code permission grants written by the harness.
.claude/settings.local.json
